<%= render partial: 'serverless_admin/tabs', locals: { selected: 'costexplorer' } %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'serverless_costexplorer', plugin: 'redmine_serverless_costexplorer' %>
  <%= javascript_include_tag 'serverless_costexplorer', plugin: 'redmine_serverless_costexplorer', type: 'module' %>
<% end %>

<% unless @enabled %>
<p class="warning"><%= l(:text_serverless_costexplorer_disabled) %></p>
<% end %>

<% if @last_request&.error && !@last_request.pending? %>
<%# Only the error's class here; the daily task logs the whole message %>
<div class="flash error" id="serverless-costexplorer-error">
  <%= l(:text_serverless_costexplorer_failed, time: format_time(@last_request.requested_at), error: @last_request.error.sub(/: .*/m, '')) %>
  <% if @last_request.unreachable? %><br><%= l(:text_serverless_costexplorer_unreachable) %><% end %>
</div>
<% end %>

<div class="contextual" id="serverless-costexplorer-updated">
  <% if @last_request&.pending? %>
  <%= l(:text_serverless_costexplorer_pending, time: format_time(@last_request.requested_at)) %>
  <% elsif @snapshot %>
  <%= l(:label_serverless_costexplorer_updated, time: format_time(@snapshot.fetched_at)) %>
  <% end %>
</div>

<% if @snapshot %>
<% costs = @snapshot.data %>
<% currency = costs['currency'] %>
<% today = costs['today'] ? Date.parse(costs['today']) : @snapshot.fetched_at.utc.to_date %>
<p><%= l(:text_serverless_costexplorer_about) %></p>

<div class="autoscroll">
<table class="list totals" id="serverless-costexplorer-summary">
<tbody>
<tr>
    <td class="name"><%= l(:label_serverless_costexplorer_month_to_date) %></td>
    <td class="amount"><%= serverless_costexplorer_amount(costs.dig('this_month', 'total'), currency) %></td>
    <td></td>
</tr>
<tr>
    <td class="name"><%= l(:label_serverless_costexplorer_forecast) %></td>
    <td class="amount"><%= serverless_costexplorer_amount(costs.dig('forecast', 'total'), currency) %></td>
    <td><% unless costs.dig('forecast', 'total') %><%= l(:text_serverless_costexplorer_no_forecast, error: costs.dig('forecast', 'error').to_s.sub(/: .*/m, '')) %><% end %></td>
</tr>
<tr>
    <td class="name"><%= l(:label_serverless_costexplorer_previous_month_total) %></td>
    <td class="amount"><%= serverless_costexplorer_amount(costs.dig('previous_month', 'total'), currency) %></td>
    <td><%= serverless_costexplorer_estimated(costs.dig('previous_month', 'estimated')) %></td>
</tr>
</tbody>
</table>
</div>

<h3><%= l(:label_serverless_costexplorer_by_service) %></h3>

<% if costs['services'].present? %>
<div class="autoscroll">
<table class="list services" id="serverless-costexplorer-services"><thead>
<tr>
    <th><%= l(:label_serverless_costexplorer_service) %></th>
    <th class="amount"><%= l(:label_serverless_costexplorer_this_month) %></th>
    <th class="amount"><%= l(:label_serverless_costexplorer_previous_month) %></th>
</tr></thead>
<tbody>
<%# Each service is a group of its usage types, collapsed, as Redmine's grouped issue list (toggleRowGroup) %>
<% costs['services'].each do |row| %>
<% details = Array(row['details']) %>
<tr class="<%= 'group' if details.any? %>">
    <td class="name">
      <% if details.any? %>
      <span class="expander icon icon-collapsed" role="button" tabindex="0" aria-expanded="false"
            title="<%= l(:label_serverless_costexplorer_usage_types) %>"
            onclick="toggleRowGroup(this); this.setAttribute('aria-expanded', $(this).closest('tr').hasClass('open'));"
            onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); }"><%= sprite_icon('angle-right') %></span>
      <% end %>
      <span class="name"><%= row['name'] %></span>
    </td>
    <td class="amount"><%= serverless_costexplorer_amount(row['this_month'], currency) %></td>
    <td class="amount"><%= serverless_costexplorer_amount(row['previous_month'], currency) %></td>
</tr>
<% details.each do |detail| %>
<tr class="idnt idnt-1" style="display: none;">
    <td class="name"><%= detail['name'] %></td>
    <td class="amount"><%= serverless_costexplorer_amount(detail['this_month'], currency) %></td>
    <td class="amount"><%= serverless_costexplorer_amount(detail['previous_month'], currency) %></td>
</tr>
<% end %>
<% end %>
</tbody>
</table>
</div>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<h3><%= l(:label_serverless_costexplorer_daily) %></h3>

<% days = costs['daily'].to_a.last(RedmineServerlessCostexplorer::Fetcher::DAYS) %>
<% if days.any? %>
<% chart = serverless_costexplorer_daily_chart(days, today) %>
<%# As Redmine's charts (repositories/stats); the table under it has the same values %>
<div class="serverless-costexplorer-graph hide-when-print"
     data-controller="serverless-costexplorer--daily"
     data-serverless-costexplorer--daily-currency-value="<%= currency %>">
  <template data-serverless-costexplorer--daily-target="labels">
    <%= chart['labels'].to_json %>
  </template>
  <template data-serverless-costexplorer--daily-target="datasets">
    <%= chart['datasets'].to_json %>
  </template>
  <canvas id="serverless-costexplorer-daily-chart" data-serverless-costexplorer--daily-target="canvas"
          role="img" aria-label="<%= l(:label_serverless_costexplorer_daily_chart) %>"></canvas>
</div>

<div class="autoscroll">
<table class="list days" id="serverless-costexplorer-daily"><thead>
<tr>
    <th><%= l(:label_date) %></th>
    <th class="amount"><%= l(:label_serverless_costexplorer_amount) %></th>
</tr></thead>
<tbody>
<% days.reverse_each do |day| %>
<tr>
    <td><%= format_date(Date.parse(day['date'])) %></td>
    <%# The badge before the amount, so that the amounts stay aligned on the right %>
    <td class="amount"><%= serverless_costexplorer_estimated(serverless_costexplorer_estimated_day?(day, today)) %> <%= serverless_costexplorer_amount(day['amount'], currency) %></td>
</tr>
<% end %>
</tbody>
</table>
</div>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<% if costs['tag_key'] %>
<h3><%= l(:label_serverless_costexplorer_by_tag, tag: costs['tag_key']) %></h3>

<% tagged = costs['tags'].to_a.reject { |row| serverless_costexplorer_tag_value(row['name'], costs['tag_key']) == l(:label_serverless_costexplorer_untagged) } %>
<% if tagged.empty? %>
<p class="warning" id="serverless-costexplorer-no-tag"><%= l(:text_serverless_costexplorer_no_tag_data, tag: costs['tag_key']) %></p>
<% end %>
<% if costs['tags'].present? %>
<div class="autoscroll">
<table class="list tags" id="serverless-costexplorer-tags"><thead>
<tr>
    <th><%= costs['tag_key'] %></th>
    <th class="amount"><%= l(:label_serverless_costexplorer_this_month) %></th>
    <th class="amount"><%= l(:label_serverless_costexplorer_previous_month) %></th>
</tr></thead>
<tbody>
<% costs['tags'].each do |row| %>
<tr>
    <td class="name"><%= serverless_costexplorer_tag_value(row['name'], costs['tag_key']) %></td>
    <td class="amount"><%= serverless_costexplorer_amount(row['this_month'], currency) %></td>
    <td class="amount"><%= serverless_costexplorer_amount(row['previous_month'], currency) %></td>
</tr>
<% end %>
</tbody>
</table>
</div>
<% end %>
<% end %>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
