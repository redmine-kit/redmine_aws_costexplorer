<%= render partial: 'serverless_admin/tabs', locals: { selected: 'costs' } %>

<% unless @enabled %>
  <p class="warning"><%= l(:text_serverless_costs_disabled) %></p>
<% end %>

<% if @last_request&.pending? %>
  <p class="flash notice"><%= l(:text_serverless_costs_pending, time: format_time(@last_request.requested_at)) %></p>
<% elsif @last_request&.error %>
  <div class="flash error" id="serverless-costs-error">
    <p><%= l(:text_serverless_costs_failed, time: format_time(@last_request.requested_at)) %></p>
    <p><%= @last_request.error.truncate(500) %></p>
    <% if @last_request.unreachable? %><p><%= l(:text_serverless_costs_unreachable) %></p><% end %>
  </div>
<% end %>

<h3><%= l(:label_serverless_costs_account) %></h3>
<% if @snapshot.nil? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<% costs = @snapshot.data %>
<% currency = costs['currency'] %>
<p><%= l(:text_serverless_costs_about, time: format_time(@snapshot.fetched_at)) %></p>

<table class="list" id="serverless-costs-summary">
  <tbody>
    <tr>
      <th><%= l(:label_serverless_costs_month_to_date) %></th>
      <td><%= serverless_cost_amount(costs.dig('this_month', 'total'), currency) %>
        <%= serverless_cost_estimated(costs.dig('this_month', 'estimated')) %></td>
    </tr>
    <tr>
      <th><%= l(:label_serverless_costs_forecast) %></th>
      <td>
        <% if costs.dig('forecast', 'total') %>
          <%= serverless_cost_amount(costs.dig('forecast', 'total'), currency) %>
        <% else %>
          - <em class="info"><%= l(:text_serverless_costs_no_forecast) %> <%= costs.dig('forecast', 'error') %></em>
        <% end %>
      </td>
    </tr>
    <tr>
      <th><%= l(:label_serverless_costs_previous_month) %></th>
      <td><%= serverless_cost_amount(costs.dig('previous_month', 'total'), currency) %>
        <%= serverless_cost_estimated(costs.dig('previous_month', 'estimated')) %></td>
    </tr>
  </tbody>
</table>

<h3><%= l(:label_serverless_costs_by_service) %></h3>
<% if costs['services'].blank? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<table class="list" id="serverless-costs-services">
  <thead>
    <tr>
      <th><%= l(:label_serverless_costs_service) %></th>
      <th><%= l(:label_serverless_costs_this_month) %></th>
      <th><%= l(:label_serverless_costs_previous_month) %></th>
    </tr>
  </thead>
  <tbody>
  <% costs['services'].each do |row| %>
    <tr>
      <td class="name"><%= row['name'] %></td>
      <td><%= serverless_cost_amount(row['this_month'], currency) %></td>
      <td><%= serverless_cost_amount(row['previous_month'], currency) %></td>
    </tr>
  <% end %>
  </tbody>
</table>
<% end %>

<h3><%= l(:label_serverless_costs_daily) %></h3>
<% days = costs['daily'].to_a.last(RedmineServerlessCost::Fetcher::DAYS) %>
<% if days.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<% max = days.map { |day| BigDecimal(day['amount']) }.max %>
<table class="list" id="serverless-costs-daily">
  <thead>
    <tr>
      <th><%= l(:label_date) %></th>
      <th><%= l(:label_serverless_costs_amount) %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  <% days.reverse_each do |day| %>
    <% amount = serverless_cost_amount(day['amount'], currency) %>
    <tr>
      <td><%= format_date(Date.parse(day['date'])) %></td>
      <td><%= amount %> <%= serverless_cost_estimated(day['estimated']) %></td>
      <td><%= serverless_cost_bar(day['amount'], max, amount) %></td>
    </tr>
  <% end %>
  </tbody>
</table>
<% end %>

<% if costs['tag_key'] %>
<h3><%= l(:label_serverless_costs_by_tag, tag: costs['tag_key']) %></h3>
<% tagged = costs['tags'].to_a.reject { |row| serverless_cost_tag_value(row['name'], costs['tag_key']) == l(:label_serverless_costs_untagged) } %>
<% if tagged.empty? %>
  <p class="warning" id="serverless-costs-no-tag"><%= l(:text_serverless_costs_no_tag_data, tag: costs['tag_key']) %></p>
<% end %>
<% if costs['tags'].present? %>
<table class="list" id="serverless-costs-tags">
  <thead>
    <tr>
      <th><%= costs['tag_key'] %></th>
      <th><%= l(:label_serverless_costs_this_month) %></th>
      <th><%= l(:label_serverless_costs_previous_month) %></th>
    </tr>
  </thead>
  <tbody>
  <% costs['tags'].each do |row| %>
    <tr>
      <td class="name"><%= serverless_cost_tag_value(row['name'], costs['tag_key']) %></td>
      <td><%= serverless_cost_amount(row['this_month'], currency) %></td>
      <td><%= serverless_cost_amount(row['previous_month'], currency) %></td>
    </tr>
  <% end %>
  </tbody>
</table>
<% end %>
<% end %>
<% end %>

<% if @enabled %>
<h3><%= l(:label_serverless_costs_refresh) %></h3>
<p><%= l(:text_serverless_costs_refresh, count: @tag_key ? 4 : 3) %></p>
<%= form_tag({ action: 'refresh' }, method: :post) do %>
  <% if ServerlessCostSnapshot.refresh_allowed? %>
    <p><%= submit_tag l(:button_serverless_costs_refresh) %></p>
  <% else %>
    <p><%= submit_tag l(:button_serverless_costs_refresh), disabled: true %>
      <em class="info"><%= l(:text_serverless_costs_refresh_after, time: format_time(ServerlessCostSnapshot.refresh_allowed_at)) %></em></p>
  <% end %>
<% end %>
<% end %>
