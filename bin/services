#!/usr/bin/env bash
# Starts the services for the tests, or stops them with --down: PostgreSQL 16,
# and LocalStack when LOCALSTACK_AUTH_TOKEN is set (as in CI), moto otherwise.
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f test/compose.yml -p redmine-serverless-costexplorer-test --profile localstack)
if [[ "${1:-}" == "--down" ]]; then
  "${compose[@]}" down -v
  exit 0
fi
if [[ -n "${LOCALSTACK_AUTH_TOKEN:-}" ]]; then
  services=(postgres localstack)
else
  services=(postgres moto)
fi
if ! "${compose[@]}" up -d --wait "${services[@]}"; then
  "${compose[@]}" ps -a >&2
  "${compose[@]}" logs --tail 80 >&2
  exit 1
fi
