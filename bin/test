#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, with Cost Explorer on
# moto, in Docker.
#   bin/test                 # the plugin's tests, then the Redmine tests around administration and jobs
#   bin/test --redmine       # also every Redmine test, with the plugin installed
#   bin/test <files>         # some files of the plugin's tests
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-serverless-cost-test
network=redmine-serverless-cost-test_default
bin/services >/dev/null
docker buildx build --load -q -t "$image" -f test/Dockerfile . >/dev/null
setup='bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null'
run() {
  docker run --rm --network "$network" -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}" "$image" \
    sh -c "$setup"' && "$@"' test "$@"
}
# The plugin's tests, with coverage written to coverage/coverage.xml.
run_plugin() {
  mkdir -p coverage
  docker run --rm --network "$network" -e PLUGIN_COVERAGE=1 -e PARALLEL_WORKERS=1 \
    -v "$PWD/coverage:/redmine/plugins/redmine_serverless_cost/coverage" "$image" \
    sh -c "$setup"' && "$@"' test "$@"
}
redmine_tests=(test/functional/admin_controller_test.rb test/unit/lib/redmine/plugin_test.rb)
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  run_plugin bin/rails test plugins/redmine_serverless_cost/test
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run_plugin bin/rails test "${@/#/plugins/redmine_serverless_cost/}"
else
  run_plugin bin/rails test plugins/redmine_serverless_cost/test
  run bin/rails test "${redmine_tests[@]}"
fi
