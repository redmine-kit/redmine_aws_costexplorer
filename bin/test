#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, with Cost Explorer on
# moto, and also on LocalStack when LOCALSTACK_AUTH_TOKEN is set, in Docker.
#   bin/test                 # the plugin's tests, then the Redmine tests around administration and jobs
#   bin/test --redmine       # also every Redmine test, with the plugin installed
#   bin/test <files>         # some files of the plugin's tests
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-serverless-costexplorer-test
network=redmine-serverless-costexplorer-test_default
bin/services >/dev/null
# The LocalStack tests (test/integration/localstack_test.rb) run only when
# LocalStack started (bin/services starts it with LOCALSTACK_AUTH_TOKEN).
if [[ -n "$(docker compose -f test/compose.yml -p redmine-serverless-costexplorer-test --profile localstack \
  ps -q --status running localstack)" ]]; then
  backend=localstack
else
  backend=moto
fi
echo "AWS backends: moto$([[ $backend == localstack ]] && echo ' and LocalStack')"
docker buildx build --load -q -t "$image" -f test/Dockerfile . >/dev/null
setup='bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null'
run() {
  docker run --rm --network "$network" -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}" "$image" \
    sh -c "$setup"' && "$@"' test "$@"
}
# The plugin's tests, with coverage written to coverage/coverage.xml.
run_plugin() {
  mkdir -p coverage
  docker run --rm --network "$network" -e TEST_AWS_BACKEND="$backend" -e PLUGIN_COVERAGE=1 -e PARALLEL_WORKERS=1 \
    -v "$PWD/coverage:/redmine/plugins/redmine_serverless_costexplorer/coverage" "$image" \
    sh -c "$setup"' && "$@"' test "$@"
}
redmine_tests=(test/functional/admin_controller_test.rb test/unit/lib/redmine/plugin_test.rb)
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  run_plugin bin/rails test plugins/redmine_serverless_costexplorer/test
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run_plugin bin/rails test "${@/#/plugins/redmine_serverless_costexplorer/}"
else
  run_plugin bin/rails test plugins/redmine_serverless_costexplorer/test
  run bin/rails test "${redmine_tests[@]}"
fi
